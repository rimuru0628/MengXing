rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100;
    }

    function isValidDailyActivity() {
      let data = request.resource.data;
      return data.keys().hasAll(['date', 'steps'])
        && data.steps is int
        && data.steps >= 0
        && data.steps <= 100000;
    }

    function isValidWalkingSession() {
      let data = request.resource.data;
      return data.keys().hasAll(['date', 'startTime', 'durationSeconds'])
        && data.durationSeconds is int
        && data.durationSeconds >= 0;
    }

    // ─── Global deny all by default ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Users collection ─────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // ── Profile ──────────────────────────────────────────────────────
      match /profile/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProfile();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Settings ─────────────────────────────────────────────────────
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ── Streak ───────────────────────────────────────────────────────
      match /streak/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ── Daily Activity ────────────────────────────────────────────────
      // Date format: yyyy-MM-dd
      match /daily_activity/{dateKey} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDailyActivity();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Walking Sessions ──────────────────────────────────────────────
      match /walking_sessions/{walkId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWalkingSession();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Workout History ───────────────────────────────────────────────
      match /workout_history/{historyId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Achievements ──────────────────────────────────────────────────
      match /achievements/{achievementId} {
        allow read: if isOwner(userId);
        // Only write allowed — achievement unlock is append-only in practice
        allow create, update: if isOwner(userId);
        // No client-side delete for achievements
        allow delete: if false;
      }

      // ── Challenges ────────────────────────────────────────────────────
      match /challenges/{challengeId} {
        allow read, write: if isOwner(userId);
      }

      // ── Notifications ─────────────────────────────────────────────────
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── Public exercise catalog ──────────────────────────────────────────
    // All authenticated users can read; only admins can write (via Admin SDK)
    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed via Firebase Admin SDK / console
    }

    // ─── App config (read-only for users) ─────────────────────────────────
    match /app_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
